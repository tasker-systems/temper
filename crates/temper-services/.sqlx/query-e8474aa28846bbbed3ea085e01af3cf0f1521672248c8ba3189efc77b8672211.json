  "query": "SELECT e.id, et.name, e.emitter_entity_id, e.occurred_at, e.invocation_id, e.metadata\n             FROM kb_events e\n             JOIN kb_event_types et ON et.id = e.event_type_id\n            WHERE e.invocation_id = $1\n            ORDER BY e.occurred_at, e.id",
