{
  "$defs": {
    "FacetPredicate": {
      "description": "One `kb_properties` facet predicate, at the inner-key grain the facet model uses.",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Narrowing over resources. Every field is AND-composed; an unset field narrows nothing.\n\nAn unknown value on a closed vocabulary (`doc_type`, `stage`, `status`) is a REFUSAL\n(`RefusalReason::UnknownFilterValue`), never a confident empty page — the audit found four\nfilters that accept nonsense and return one.",
  "properties": {
    "doc_type": {
      "description": "`kb_properties` where `property_key = 'doc_type'`.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "facets": {
      "description": "`kb_properties` where `property_key = 'facet'`.",
      "items": {
        "$ref": "#/$defs/FacetPredicate"
      },
      "type": "array"
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "description": "`kb_properties` where `property_key = 'tags'`. AND-containment.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "title_contains": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "ResourceFilter",
  "type": "object"
}
