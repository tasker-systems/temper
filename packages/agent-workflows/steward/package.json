{
  "name": "@temper/steward-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build:dep": "npm --prefix ../../../clients/temper-ts ci && npm --prefix ../../../clients/temper-ts run build && npm --prefix ../../../clients/temper-telemetry-ts ci && npm --prefix ../../../clients/temper-telemetry-ts run build",
    "prebuild": "npm run build:dep",
    "build": "eve build",
    "dev": "eve dev",
    "start": "eve start",
    "pretest": "npm run build:dep",
    "test": "vitest run",
    "pretypecheck": "npm run build:dep",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vercel/connect": "2.4.1",
    "ai": "^7.0.128",
    "eve": "^0.73.0",
    "openapi-fetch": "^0.17.0",
    "@tasker-systems/temper-telemetry-ts": "file:../../../clients/temper-telemetry-ts",
    "@tasker-systems/temper-ts": "file:../../../clients/temper-ts",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.1-rc",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "ai": "^7.0.128"
  },
  "engines": {
    "node": "24.x"
  }
}
