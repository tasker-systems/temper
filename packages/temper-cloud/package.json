{
  "name": "temper-cloud",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.api.json",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "check": "biome check",
    "check:fix": "biome check --fix"
  },
  "dependencies": {
    "@kreuzberg/node": "latest",
    "@neondatabase/serverless": "^1",
    "@node-saml/node-saml": "^5",
    "@vercel/blob": "^2",
    "jose": "^6",
    "pino": "^10.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22",
    "@xmldom/xmldom": "^0.9.10",
    "docx": "^9.15.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "typescript": "^5.8",
    "vitest": "^4.1.12",
    "xml-crypto": "^6.4.0"
  }
}
