{
  "name": "@tasker-systems/temper-design",
  "version": "0.6.2",
  "description": "temper's theme contract, themes and shared rendering modules: the one source every temper surface paints from",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasker-systems/temper.git",
    "directory": "packages/temper-design"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "contract/*.css",
    "contract/theme.schema.json",
    "*/theme.css",
    "*/theme.json",
    "themes.json",
    "brand/*.svg",
    "guard/colours.mjs",
    "toolchain/check.mjs",
    "toolchain/majors.json",
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "exports": {
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./sanitize": {
      "types": "./dist/sanitize.d.ts",
      "default": "./dist/sanitize.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./region": {
      "types": "./dist/region.d.ts",
      "default": "./dist/region.js"
    },
    "./omission": {
      "types": "./dist/omission.d.ts",
      "default": "./dist/omission.js"
    },
    "./themes.json": "./themes.json",
    "./contract/*": "./contract/*",
    "./brand/*": "./brand/*",
    "./*/theme.css": "./*/theme.css",
    "./*/theme.json": "./*/theme.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "jsdom": "^30",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
