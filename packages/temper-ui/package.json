{
  "name": "@temper/ui",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "biome": "biome check",
    "biome:fix": "biome check --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "toolchain": "node ../temper-design/toolchain/check.mjs --adapter @sveltejs/adapter-vercel",
    "guard:colours": "node ../temper-design/guard/colours.mjs colour-guard.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/adapter-vercel": "^5",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tailwindcss/vite": "^4",
    "@testing-library/svelte": "^5",
    "@types/d3-force": "^3",
    "@types/d3-hierarchy": "^3",
    "@types/d3-polygon": "^3",
    "@types/d3-selection": "^3",
    "@types/d3-zoom": "^3",
    "jsdom": "^30",
    "playwright": "^1.64.1",
    "svelte": "^5",
    "svelte-check": "^4",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@tasker-systems/temper-design": "file:../temper-design",
    "@tasker-systems/temper-telemetry-ts": "file:../../clients/temper-telemetry-ts",
    "@vercel/functions": "^3.10.1",
    "d3-force": "^3",
    "d3-hierarchy": "^3",
    "d3-polygon": "^3",
    "d3-selection": "^3",
    "d3-zoom": "^3",
    "jose": "^6.2.12",
    "postgres": "^3",
    "wx-svelte-grid": "^2.7.0"
  }
}
