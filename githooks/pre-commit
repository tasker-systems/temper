#!/usr/bin/env bash
set -euo pipefail

# Selective pre-commit: run only the check batteries the STAGED change can
# actually affect. The hook used to run the whole battery — cargo fmt, a
# full-workspace clippy, cargo doc, two OpenAPI gates, tsc and biome — on every
# commit regardless of what changed, which made a one-line docs or TypeScript
# commit pay the entire Rust toolchain cost. That is what trains `--no-verify`,
# and a hook people routinely bypass protects nothing.
#
# So we classify the staged files and run each battery only when its inputs
# moved, mirroring the philosophy of .github/scripts/detect-ci-scope.sh:
#
#   Rust battery (fmt, clippy, doc, OpenAPI gates)  — only if a Rust-affecting
#       file is staged (a crate, e2e, Cargo.*, .sqlx, a migration, openapi.json,
#       or the cargo-make wiring).
#   temper-cloud TS battery (typecheck, biome)      — only if a file under
#       packages/temper-cloud/ is staged.
#   temper-ui battery (svelte-check, biome)         — only if a file under
#       packages/temper-ui/ is staged.
#
# The temper-ui battery was added after this hook said "the UI and SDK trees are
# covered in CI, not here" and a break proved covered-in-CI insufficient:
# `e226fce2` added four required fields to `ResourceListResponse`, staling a
# fallback cast in vault/search/+page.server.ts, and it stayed red for two
# commits because NOTHING local looks at temper-ui — not this hook, and not
# `cargo make check`, whose TypeScript step is tsc-over-temper-cloud.
#
# The trigger is `^packages/temper-ui/` rather than a hand-picked source glob,
# and that is the load-bearing part. The break above staged NO hand-written UI
# file — it staged `src/lib/types/generated/resource.ts`. Because the ts-rs
# output tree lives INSIDE temper-ui, "a shared Rust type was regenerated" and
# "a temper-ui file is staged" are the same event, and regenerating a shared
# type is exactly what stales a UI consumer. Measured over this branch: the one
# commit that broke the UI staged a temper-ui file; the one that did not, did
# not. Cost is ~3.4s, and only on commits that touch the tree.
#
# A commit that touches neither — docs, other TS packages, workflow YAML — runs
# nothing and returns instantly. Conservative by construction: the classifier is
# an ALLOWLIST of what each battery needs, so anything unrecognized simply does
# not switch a battery on here; CI (which diffs against the base and runs the
# full gates) remains the backstop. This hook is a fast local pre-filter, not
# the authority.
#
# Escape hatch unchanged: `git commit --no-verify` still skips everything. The
# point of this change is that you should rarely want to.

# --diff-filter=ACMR: added / copied / modified / renamed. A staged DELETION
# alone cannot break fmt/clippy/tsc, and counting it would run a battery for a
# file that is gone. --cached: only what is actually staged for THIS commit.
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED" ]; then
  echo "==> pre-commit: nothing staged — skipping."
  exit 0
fi

staged_match() { echo "$STAGED" | grep -qE "$1"; }

# Rust-affecting: anything that can move a fmt / clippy / doc / OpenAPI result.
# openapi.json is here because the OpenAPI gates regenerate it from the router
# and diff — a manual edit must be caught. Cargo.* / .sqlx / migrations move the
# build or the compile-time query verification; tools/cargo-make + Makefile.toml
# move how the gates themselves run.
RUST_RE='^crates/|^tests/e2e/|^Cargo\.(toml|lock)$|^\.sqlx/|^migrations/|^openapi\.json$|^tools/cargo-make/|^Makefile\.toml$|^rust-toolchain'

TS_RE='^packages/temper-cloud/'

# The whole tree, deliberately: the ts-rs generated types live under
# src/lib/types/generated/, so this also fires for "a shared Rust type was
# regenerated" — the case that motivated the battery.
UI_RE='^packages/temper-ui/'

HAS_RUST=false; staged_match "$RUST_RE" && HAS_RUST=true
HAS_TS=false;   staged_match "$TS_RE"   && HAS_TS=true
HAS_UI=false;   staged_match "$UI_RE"   && HAS_UI=true

if [ "$HAS_RUST" = "false" ] && [ "$HAS_TS" = "false" ] && [ "$HAS_UI" = "false" ]; then
  echo "==> pre-commit: no Rust, temper-cloud TypeScript or temper-ui staged — skipping (docs/other only)."
  exit 0
fi

echo "==> Running pre-commit checks (rust=${HAS_RUST}, temper-cloud-ts=${HAS_TS}, temper-ui=${HAS_UI})..."

if [ "$HAS_RUST" = "true" ]; then
  echo "  Checking formatting..."
  cargo fmt --all -- --check
  echo "  ✓ Formatting OK"

  echo "  Running Clippy..."
  # SQLX_OFFLINE: --all-features pulls temper-next's query! macros, which resolve
  # against the `temper_next` namespace, not the dev DB's default `public`
  # search_path — live validation collapses to E0282. Use the committed .sqlx
  # caches instead (matches CI's code-quality job and all `cargo make` tasks).
  SQLX_OFFLINE=true cargo clippy --all-targets --all-features -- -D warnings
  echo "  ✓ Clippy OK"

  echo "  Checking docs..."
  SQLX_OFFLINE=true RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items --quiet
  echo "  ✓ Docs OK"

  # openapi.json is a committed product of the Axum router, so it goes stale from a new route OR from a
  # new field on any schema type reachable from one. Nothing else in this hook notices. Cheap here:
  # clippy above already compiled temper-api, so this is just running the emit-openapi bin.
  # Output is captured and replayed only on failure — check-openapi-spec.sh prints the offending diff.
  echo "  Checking OpenAPI spec..."
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  for openapi_gate in check-openapi-spec.sh check-openapi-routes.sh; do
    if ! openapi_out=$(SQLX_OFFLINE=true bash "$REPO_ROOT/.github/scripts/$openapi_gate" 2>&1); then
      echo "$openapi_out" >&2
      echo "  ✗ OpenAPI check failed ($openapi_gate) — run: cargo make openapi" >&2
      exit 1
    fi
  done
  echo "  ✓ OpenAPI OK"
fi

if [ "$HAS_TS" = "true" ]; then
  echo "  TypeScript typecheck..."
  (cd packages/temper-cloud && bun run typecheck)
  echo "  ✓ TypeScript OK"

  echo "  Biome lint & format..."
  (cd packages/temper-cloud && bun run check)
  echo "  ✓ Biome OK"
fi

if [ "$HAS_UI" = "true" ]; then
  # An absent install means this developer has not set the UI up — that is not a
  # broken commit, and failing here would say it was. Skip LOUDLY: a silent skip
  # would make the battery look present when it is not, which is the failure this
  # battery exists to end. A stale install is a different matter and is left to
  # fail: it reds with `d3-*` "implicit any" / "cannot find package" under
  # src/lib/graph/atlas/layout/, and the fix is `bun install` (see CLAUDE.md).
  if [ ! -d packages/temper-ui/node_modules ]; then
    echo "  ! temper-ui staged but packages/temper-ui/node_modules is absent — SKIPPING svelte-check." >&2
    echo "    Run 'cd packages/temper-ui && bun install' to enable it. CI checks this tree regardless." >&2
  else
    echo "  temper-ui svelte-check..."
    (cd packages/temper-ui && bun run check)
    echo "  ✓ temper-ui types OK"

    # Biome, because svelte-check alone was not enough — and the reason this ran
    # svelte-check ONLY was wrong on both of its claims. It said biome "exits 0
    # on warnings, so it gates nothing", and that CI runs it "with the same
    # non-blocking result". Biome exits 0 on warnings and NON-ZERO on errors, and
    # test-typescript.yml's `Lint & format (Biome)` step fails the UI job on one:
    # `7595d45a` landed an unsorted import block (assist/source/organizeImports)
    # that stayed red for six commits, invisible because nothing local ran biome,
    # `cargo make check` does not reach this tree, and CI had never run on the
    # branch. First CI run caught it.
    #
    # --diagnostic-level=error is what makes this cheap rather than noisy. The
    # tree carries ~46 standing warnings; printing them on every UI commit is the
    # output-as-noise problem this file's header names as what trains
    # `--no-verify`. The flag suppresses them from the OUTPUT only — the exit code
    # is unchanged, so the gate is identical to CI's while the screen stays quiet.
    # Verified both ways: clean tree exits 0 with one line; reintroducing the
    # unsorted import exits 1 and names organizeImports.
    echo "  temper-ui biome..."
    (cd packages/temper-ui && bun run biome --diagnostic-level=error)
    echo "  ✓ temper-ui lint OK"
  fi
fi

echo "==> All applicable pre-commit checks passed."
