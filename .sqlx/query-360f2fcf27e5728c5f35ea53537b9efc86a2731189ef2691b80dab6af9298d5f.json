{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, profile_id, auth_provider, auth_provider_user_id, email, email_verified,\n                   is_default, linked_at\n              FROM kb_profile_auth_links\n             WHERE lower(email) = lower($1)\n               AND email_verified\n             ORDER BY (email = $1) DESC, linked_at, id\n             LIMIT 1\n            ",
